{
  "name": "play100",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "100 original browser games in one fast, lightweight arcade.",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "games/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @play100/portal",
    "dev:game001": "npm run dev --workspace @play100/game-001-arrow-harbor",
    "dev:game002": "npm run dev --workspace @play100/game-002-harbor-lost-found",
    "generate:factory": "python3 scripts/generate-factory-config.py && node scripts/generate-factory-pages.mjs",
    "build": "node scripts/build-all.mjs",
    "check": "node scripts/validate-catalog.mjs && node scripts/validate-levels.mjs && node scripts/validate-game-experience.mjs && node scripts/validate-factory.mjs && npm run typecheck --workspaces --if-present",
    "test": "npm run check",
    "preview": "npx vite preview --outDir dist"
  },
  "devDependencies": {
    "typescript": "5.8.3",
    "vite": "8.2.1"
  }
}
